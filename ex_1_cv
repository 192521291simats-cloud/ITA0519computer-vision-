      "source": [
        "# Image Processing: Reading and Converting to Grayscale\n",
        "\n",
        "This notebook demonstrates how to load an image using Python and convert it into grayscale."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 408
        },
        "id": "d0721d8a",
        "outputId": "5967724d-f6b4-4c9d-f685-942bf1f01237"
      },
      "source": [
        "import urllib.request\n",
        "from PIL import Image\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Using a User-Agent header to bypass the 403 Forbidden error\n",
        "url = 'https://upload.wikimedia.org/wikipedia/commons/4/47/PNG_transparency_demonstration_1.png'\n",
        "image_path = 'sample_image.png'\n",
        "\n",
        "req = urllib.request.Request(\n",
        "    url,\n",
        "    headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'}\n",
        ")\n",
        "\n",
        "with urllib.request.urlopen(req) as response, open(image_path, 'wb') as out_file:\n",
        "    out_file.write(response.read())\n",
        "\n",
        "img = Image.open(image_path)\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.imshow(img)\n",
        "plt.title('Original Image')\n",
        "plt.axis('off')\n",
        "plt.show()"
      ],
      "execution_count": null,
