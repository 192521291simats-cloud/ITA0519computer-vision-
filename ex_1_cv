      "source": [
        "\n",
        "gray_img = img.convert('L')\n",
        "\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.imshow(gray_img, cmap='gray')\n",
        "plt.title('Grayscale Image')\n",
        "plt.axis('off')\n",
        "plt.show()"
